# Actual FRLG Forest native runs; TRUST cases are negative controls.
# Pose (x,y) facing; ? is unreported. Source/replay facts are checked.
# Calls: planned step | physical before -> after | outcome and facing passed in.
# Native: > is a plan leg; ! is a native recovery diagnostic.

[trace]
format = pokesim-native-route-text/1
bundle_format = pokesim-native-route-replay/1
profile = frlg-forest-shortfall/1
coordinate_frame = runtime-local

[context]
map = ViridianForest
elevation = 3
start = (13,28) west
flags = []
variables = {}

[case forest-one-short]
shortfall = 1
policy = reanchor
goal = (7,33) south
next_direction = south
route = west 6 open -> (7,28) west; south 5 wall -> (7,33) south
calls =
    west 6 open -> (7,28) west | (13,28) west -> (8,28) west | done facing_in=west
    west 6 wall -> (3,28) west | (8,28) west -> (3,28) west | done facing_in=west
    east 4 open -> (7,28) east | (3,28) west -> (7,28) east | done facing_in=west
    south 5 wall -> (7,33) south | (7,28) east -> (7,33) south | done facing_in=east
native =
    plan from (13,28):
    > west 6 (open) to (7,28)
    > south 5 (to wall) to (7,33)
    west 6 (open): ended at (7,28) (walked).
    ! position check: walk west 6 -> (7,28) may have ended up to 2 tiles short with nothing seen; finding the player at walls.
    plan from an unknown tile:
    > west 6 (to wall) to (3,28)
    > east 4 (open) to (7,28)
    > south 5 (to wall) to (7,33)
    west 6 (to wall): ended at (3,28) (walked).
    found again at (3,28), after 1 hold(s).
    east 4 (open): ended at (7,28) (walked).
    south 5 (to wall): ended at (7,33) (walked).
physical = (7,33) south
signs_read = 0
violations = []
failure = ""

