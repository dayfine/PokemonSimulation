# Native BDSP recovery capture: shared context, then one row per action.
# Pose: (x,y) facing; ? = unreported facing. Zero/false are explicit.
# Calls: action | physical before -> after | native report.
# Native facts: > is a leg belonging to the preceding plan.

[trace]
format = pokesim-native-route-text/1
bundle_format = pokesim-native-route-replay/1
profile = bdsp-route202-gridsim/1
coordinate_frame = runtime-local

[context]
map = Route202
elevation = 0
start = (26,5) east
goal = (28,5) west
running_shoes = true
move_speed = run
flags = []
variables = {"VAR_ROUTE_202_STATE": 1}

[case last-tap-before]
encounter = before tap 2; origin=current_leg
wall_interruptions = 0
calls =
    turn east 50ms | (26,5) east -> (26,5) east | queued=false
    taps east 2 | (26,5) east -> (27,5) east | limit 1600ms battles=1 credited=2 origin=current_leg
    wall east 2050ms | (27,5) east -> (30,5) east | blocked 1350ms battles=0 credited=3 origin=current_leg pause=false
    turn west 50ms | (30,5) east -> (30,5) west | queued=false
    taps west 2 | (30,5) west -> (28,5) west | limit 1600ms battles=0 credited=2 origin=current_leg
native =
    plan from (26,5):
    > east 2 (open) to (28,5)
    east 2 (open): encounter: credited taps do not establish pose, at (26,5), (27,5), (28,5); planning again.
    plan from (26,5), (27,5), (28,5):
    > east 4 (to wall) to (30,5)
    > west 2 (open) to (28,5)
    east 4 (to wall): ended at (30,5) (walked).
    west 2 (open): ended at (28,5) (walked).
    arrived at (28,5).
declared = (28,5) ?
physical = (28,5) west
failure = ""

