# Install as .github/workflows/map-pack-integrity.yml in the owning Arduino PR.
# Replace IMPLEMENTATION_COMMIT with this implementation's full merged commit.
name: Map pack integrity
on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
jobs:
  map-pack-integrity:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - uses: dayfine/PokemonSimulation/integrations/arduino-source/verify-map-packs@IMPLEMENTATION_COMMIT
