{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dayfine/PokemonSimulation/schemas/story-replay-cases.schema.json",
  "type": "object",
  "required": ["format", "evidence_status", "coordinate_frame", "cases"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "pokesim-story-replay-cases/1"},
    "evidence_status": {"const": "synthetic-scripted-observations"},
    "coordinate_frame": {"const": "runtime-local"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "input", "expectation"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "input": {
            "type": "object",
            "required": ["entry", "signals"],
            "additionalProperties": false,
            "properties": {
              "entry": {
                "type": "object",
                "required": ["basis", "screen", "pose"],
                "additionalProperties": false,
                "properties": {
                  "basis": {"const": "scripted"},
                  "screen": {"type": "string", "minLength": 1},
                  "pose": {"$ref": "#/$defs/pose"}
                }
              },
              "signals": {
                "type": "object",
                "propertyNames": {"minLength": 1},
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["kind", "from", "direction"],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {"const": "wild-encounter"},
                        "from": {"$ref": "#/$defs/pose"},
                        "direction": {"enum": ["north", "east", "south", "west"]}
                      }
                    },
                    {
                      "type": "object",
                      "required": ["kind"],
                      "additionalProperties": false,
                      "properties": {"kind": {"const": "unconfirmed-transition"}}
                    },
                    {
                      "type": "object",
                      "required": ["kind", "basis", "screen", "pose", "received"],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {"const": "scene-observation"},
                        "basis": {"const": "scripted"},
                        "screen": {"type": "string", "minLength": 1},
                        "pose": {"$ref": "#/$defs/pose"},
                        "received": {
                          "type": "object",
                          "propertyNames": {"minLength": 1},
                          "additionalProperties": {"type": "integer", "minimum": 1}
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {"const": "movement-script"},
                        "clear_npcs": {"type": "array", "items": {"type": "string", "minLength": 1}},
                        "encounter": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/encounter"}]}
                      },
                      "required": ["kind", "clear_npcs", "encounter"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {"const": "bdsp-observation"},
                        "basis": {"const": "scripted"},
                        "screen": {"enum": ["overworld", "dialogue"]},
                        "pose": {"$ref": "#/$defs/pose"},
                        "result": {
                          "type": "object",
                          "oneOf": [
                            {
                              "properties": {"transition": {"type": "boolean"}},
                              "required": ["transition"],
                              "additionalProperties": false
                            },
                            {
                              "properties": {"npc": {"type": "string"}},
                              "required": ["npc"],
                              "additionalProperties": false
                            },
                            {
                              "properties": {"departed": {"type": "string"}},
                              "required": ["departed"],
                              "additionalProperties": false
                            },
                            {
                              "properties": {"party_healed": {"type": "boolean"}},
                              "required": ["party_healed"],
                              "additionalProperties": false
                            }
                          ]
                        }
                      },
                      "required": ["kind", "basis", "screen", "pose", "result"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "check_actions": {
                "type": "boolean",
                "description": "Assert the complete ordered expectation.actions list; never used to generate replay actions."
              }
            }
          },
          "expectation": {
            "type": "object",
            "required": [
              "status",
              "failure",
              "active_event",
              "completed_events",
              "pose",
              "pose_basis",
              "candidates",
              "received",
              "save_performed"
            ],
            "additionalProperties": false,
            "properties": {
              "status": {"enum": ["model_complete", "stopped"]},
              "failure": {"type": ["string", "null"]},
              "active_event": {"type": ["string", "null"]},
              "completed_events": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "pose": {"anyOf": [{"$ref": "#/$defs/pose"}, {"type": "null"}]},
              "pose_basis": {
                "enum": [
                  "scripted-observation",
                  "model-prediction",
                  "unknown-after-interruption",
                  "unknown-after-transition",
                  "unknown-after-scene",
                  "unknown-after-route-mismatch",
                  "unknown-after-observation"
                ]
              },
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["map", "tile", "elevation", "facing"],
                  "additionalProperties": false,
                  "properties": {
                    "map": {"type": "string", "minLength": 1},
                    "tile": {
                      "type": "array",
                      "prefixItems": [{"type": "integer"}, {"type": "integer"}],
                      "items": false,
                      "minItems": 2
                    },
                    "elevation": {"type": "integer", "minimum": 0, "maximum": 15},
                    "facing": {"anyOf": [{"enum": ["north", "east", "south", "west"]}, {"type": "null"}]}
                  }
                }
              },
              "received": {
                "type": "object",
                "propertyNames": {"minLength": 1},
                "additionalProperties": {"type": "integer", "minimum": 1}
              },
              "save_performed": {"const": false},
              "actions": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["event", "kind", "map", "direction", "tiles"],
                      "additionalProperties": false,
                      "properties": {
                        "event": {"type": "string", "minLength": 1},
                        "kind": {"enum": ["walk", "hop"]},
                        "map": {"type": "string", "minLength": 1},
                        "direction": {"enum": ["north", "east", "south", "west"]},
                        "tiles": {"type": "integer", "minimum": 1}
                      }
                    },
                    {
                      "type": "object",
                      "required": ["event", "kind", "map", "direction", "to_map", "via"],
                      "additionalProperties": false,
                      "properties": {
                        "event": {"type": "string", "minLength": 1},
                        "kind": {"const": "transition"},
                        "map": {"type": "string", "minLength": 1},
                        "direction": {"enum": ["north", "east", "south", "west"]},
                        "to_map": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
                        "via": {"enum": ["warp", "edge"]}
                      }
                    },
                    {
                      "type": "object",
                      "required": ["event", "kind", "map", "direction"],
                      "additionalProperties": false,
                      "properties": {
                        "event": {"type": "string", "minLength": 1},
                        "kind": {"const": "turn"},
                        "map": {"type": "string", "minLength": 1},
                        "direction": {"enum": ["north", "east", "south", "west"]}
                      }
                    },
                    {
                      "type": "object",
                      "required": ["event", "kind", "capability"],
                      "additionalProperties": false,
                      "properties": {
                        "event": {"type": "string", "minLength": 1},
                        "kind": {"const": "scene"},
                        "capability": {"enum": ["scripted-scene/1", "bdsp-scene-observation/1"]}
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "event": {"type": "string", "minLength": 1},
                        "kind": {"const": "door"},
                        "map": {"type": "string", "minLength": 1},
                        "direction": {"enum": ["north", "east", "south", "west"]},
                        "to_map": {"type": "string", "minLength": 1}
                      },
                      "required": ["event", "kind", "map", "direction", "to_map"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "event": {"type": "string", "minLength": 1},
                        "kind": {"const": "talk"},
                        "npc": {"type": "string", "minLength": 1}
                      },
                      "required": ["event", "kind", "npc"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {"event": {"type": "string", "minLength": 1}, "kind": {"const": "heal"}},
                      "required": ["event", "kind"],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"input": {"required": ["check_actions"], "properties": {"check_actions": {"const": true}}}}
            },
            "then": {"properties": {"expectation": {"required": ["actions"]}}},
            "else": {"properties": {"expectation": {"not": {"required": ["actions"]}}}}
          }
        ]
      }
    }
  },
  "$defs": {
    "pose": {
      "type": "object",
      "required": ["map", "tile", "elevation", "facing"],
      "additionalProperties": false,
      "properties": {
        "map": {"type": "string", "minLength": 1},
        "tile": {
          "type": "array",
          "prefixItems": [{"type": "integer"}, {"type": "integer"}],
          "items": false,
          "minItems": 2
        },
        "elevation": {"type": "integer", "minimum": 0, "maximum": 15},
        "facing": {"enum": ["north", "east", "south", "west"]}
      }
    },
    "encounter": {
      "type": "object",
      "properties": {
        "kind": {"const": "wild-encounter"},
        "from": {"$ref": "#/$defs/pose"},
        "direction": {"enum": ["north", "east", "south", "west"]}
      },
      "required": ["kind", "from", "direction"],
      "additionalProperties": false
    }
  }
}
