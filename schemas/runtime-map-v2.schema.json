{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dayfine/PokemonSimulation/main/schemas/runtime-map-v2.schema.json",
  "title": "Published runtime map version 2",
  "type": "object",
  "properties": {
    "format": {"const": "pokesim-runtime-map/2"},
    "name": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "properties": {"decomp_file": {"type": "string"}, "revision": {"type": "string"}, "date": {"type": "string"}},
      "required": ["decomp_file", "revision", "date"],
      "additionalProperties": true
    },
    "tiles": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "^[#.~w^v<>DS 8246udlroHBG]+$"},
      "minItems": 1
    },
    "elevation": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]+$"}},
    "allow_running": {"type": "boolean"},
    "points": {"type": "object", "additionalProperties": {"$ref": "#/$defs/coord"}},
    "regions": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/coord"}}},
    "npcs": {"type": "array", "items": {"$ref": "#/$defs/npc"}},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coord": {"$ref": "#/$defs/coord"},
          "name": {"type": "string"},
          "facing": {"$ref": "#/$defs/direction"},
          "hide_flag": {"type": "string"},
          "source_event": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "wander": {"$ref": "#/$defs/wander"},
          "item": {"type": "string", "minLength": 1},
          "quantity": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
        },
        "required": ["coord"],
        "additionalProperties": true,
        "allOf": [
          {
            "if": {"anyOf": [{"required": ["item"]}, {"required": ["quantity"]}]},
            "then": {
              "required": ["item"],
              "anyOf": [{"required": ["name"]}, {"required": ["source_event"]}],
              "not": {"required": ["pickup"]}
            }
          },
          {"not": {"anyOf": [{"required": ["x"]}, {"required": ["y"]}]}}
        ],
        "not": {"anyOf": [{"required": ["kind"]}, {"required": ["interaction"]}]}
      }
    },
    "signs": {"type": "array", "items": {"$ref": "#/$defs/npc"}},
    "interactables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coord": {"$ref": "#/$defs/coord"},
          "name": {"type": "string"},
          "facing": {"$ref": "#/$defs/direction"},
          "hide_flag": {"type": "string"},
          "source_event": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "wander": {"$ref": "#/$defs/wander"},
          "interaction": {
            "type": "object",
            "properties": {"kind": {"type": "string", "minLength": 1}},
            "required": ["kind"],
            "additionalProperties": true
          }
        },
        "required": ["coord", "name", "interaction"],
        "additionalProperties": true,
        "not": {"anyOf": [{"required": ["kind"]}, {"required": ["item"]}, {"required": ["quantity"]}]},
        "allOf": [{"not": {"anyOf": [{"required": ["x"]}, {"required": ["y"]}]}}]
      }
    },
    "warps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coord": {"$ref": "#/$defs/coord"},
          "enter": {
            "enum": ["walk_into", "step_on", "cave_entrance", "walk_north", "walk_south", "walk_west", "walk_east"]
          },
          "to_map": {"type": "string"},
          "to_point": {"type": "string"},
          "one_way": {
            "const": true,
            "description": "A drop: a hole (tile H, MB_FALL_WARP) you fall through. The landing has no warp back up."
          }
        },
        "required": ["coord"],
        "additionalProperties": true,
        "dependentRequired": {"to_map": ["to_point"], "to_point": ["to_map"]},
        "allOf": [{"not": {"anyOf": [{"required": ["x"]}, {"required": ["y"]}]}}]
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coord": {"$ref": "#/$defs/coord"},
          "glyph": {"enum": ["#", ".", "~", "w", "^", "v", "<", ">", "D", "S", " ", "8", "2", "4", "6"]},
          "measured_by": {"type": "string", "minLength": 1}
        },
        "required": ["coord", "glyph", "measured_by"],
        "additionalProperties": true,
        "allOf": [{"not": {"anyOf": [{"required": ["x"]}, {"required": ["y"]}]}}]
      }
    },
    "coord_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coord": {"$ref": "#/$defs/coord"},
          "width": {"type": "integer", "minimum": 1},
          "length": {"type": "integer", "minimum": 1}
        },
        "required": ["coord", "width", "length"],
        "additionalProperties": true,
        "allOf": [{"not": {"anyOf": [{"required": ["x"]}, {"required": ["y"]}]}}]
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "side": {"$ref": "#/$defs/direction"},
          "offset": {"type": "integer"},
          "to_map": {"type": "string"}
        },
        "required": ["side", "offset"],
        "additionalProperties": true
      }
    },
    "gates": {
      "description": "Barriers the story opens or closes, by gate id. The base and runtime tiles show every gate tile as G; its state at a story state comes from the flag (or switch) named here, and the map's overlay operations (op gate) say when.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tiles": {"type": "array", "items": {"$ref": "#/$defs/coord"}, "minItems": 1},
          "open_glyph": {"enum": [".", "~", "2", "4", "6", "8"]},
          "new_game": {"enum": ["open", "closed"]},
          "opens_by": {"enum": ["card_key_face_a"]},
          "flag": {"type": "string", "pattern": "^FLAG_[A-Z0-9_]+$"},
          "switch": {"type": "string", "minLength": 1},
          "open_when": {"enum": ["on", "off"]}
        },
        "required": ["tiles", "open_glyph", "new_game"],
        "oneOf": [
          {
            "required": ["opens_by", "flag"],
            "properties": {"new_game": {"const": "closed"}},
            "not": {"anyOf": [{"required": ["switch"]}, {"required": ["open_when"]}]}
          },
          {"required": ["switch", "open_when"], "not": {"anyOf": [{"required": ["opens_by"]}, {"required": ["flag"]}]}}
        ],
        "additionalProperties": false
      }
    },
    "switches": {
      "description": "Switches that open and close gates, by switch id. A statue switch (toggle true) flips a flag shared by every map in `floors`: pressing a statue flips it, and each floor redraws its gates when it loads. A Strength button (toggle false) sets a scene VAR to `set_value` for good once a boulder is pushed onto one of its `buttons` (until the game resets the VAR).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "flag": {"type": "string", "pattern": "^(FLAG|VAR)_[A-Z0-9_]+$"},
          "toggle": {"type": "boolean"},
          "floors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "statues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "coord": {"$ref": "#/$defs/coord"},
                "face_from": {"$ref": "#/$defs/coord"},
                "facing": {"$ref": "#/$defs/direction"}
              },
              "required": ["coord", "face_from", "facing"],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "set_value": {"type": "integer", "minimum": 1},
          "pressed_by": {"const": "strength_boulder"},
          "buttons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {"coord": {"$ref": "#/$defs/coord"}},
              "required": ["coord"],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": ["flag", "toggle", "floors"],
        "oneOf": [
          {
            "properties": {"toggle": {"const": true}, "flag": {"pattern": "^FLAG_"}},
            "required": ["statues"],
            "not": {"anyOf": [{"required": ["set_value"]}, {"required": ["pressed_by"]}, {"required": ["buttons"]}]}
          },
          {
            "properties": {"toggle": {"const": false}, "flag": {"pattern": "^VAR_"}},
            "required": ["set_value", "pressed_by", "buttons"],
            "not": {"required": ["statues"]}
          }
        ],
        "additionalProperties": false
      }
    },
    "hidden_items": {
      "description": "Hidden items found by facing a tile and pressing A; data only, they never block movement.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coord": {"$ref": "#/$defs/coord"},
          "item": {"type": "string", "minLength": 1},
          "quantity": {"type": "integer", "minimum": 1},
          "flag": {"type": "string"},
          "source_bg_event": {"type": "integer", "minimum": 0},
          "underfoot": {"type": "boolean"}
        },
        "required": ["coord", "item", "quantity", "flag", "source_bg_event"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format", "name", "source", "tiles"],
  "additionalProperties": true,
  "not": {"required": ["objects"]},
  "$defs": {
    "coord": {
      "type": "array",
      "items": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
      "minItems": 2,
      "maxItems": 2
    },
    "direction": {"enum": ["north", "east", "south", "west"]},
    "wander": {
      "type": "object",
      "properties": {"min": {"$ref": "#/$defs/coord"}, "max": {"$ref": "#/$defs/coord"}},
      "required": ["min", "max"],
      "additionalProperties": true
    },
    "path": {
      "type": "array",
      "description": "legs a walk-sequence person walks from their coord, back to it and over again; a last leg marked stuck ends where they stop for good",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [
          {"$ref": "#/$defs/direction"},
          {"type": "integer", "minimum": 1},
          {"const": "stuck"}
        ],
        "items": false,
        "minItems": 2
      }
    },
    "npc": {
      "type": "object",
      "properties": {
        "coord": {"$ref": "#/$defs/coord"},
        "name": {"type": "string"},
        "facing": {"$ref": "#/$defs/direction"},
        "hide_flag": {"type": "string"},
        "source_event": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "wander": {"$ref": "#/$defs/wander"},
        "path": {"$ref": "#/$defs/path"}
      },
      "required": ["coord", "name"],
      "additionalProperties": true,
      "not": {"required": ["kind"]},
      "allOf": [{"not": {"anyOf": [{"required": ["x"]}, {"required": ["y"]}]}}]
    }
  }
}
