{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayfine.github.io/PokemonSimulation/schemas/native-plan-source.schema.json",
  "title": "Pinned authoritative native story plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "repository", "revision", "file", "sha256"],
  "properties": {
    "format": {"const": "pokesim-native-plan-source/1"},
    "repository": {"const": "dayfine/Arduino-Source"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "file": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
